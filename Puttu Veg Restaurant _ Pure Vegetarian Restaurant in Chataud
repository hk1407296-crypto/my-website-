.foot-social svg { width: 18px; height: 18px; }

.foot-bottom { margin-top: 50px; padding-top: 24px; border-top: 1px solid rgba(255, 255, 255, 0.12); text-align: center; font-size: 0.85rem; }

.wa-float { position: fixed; right: 20px; bottom: 20px; z-index: 90; width: 60px; height: 60px; border-radius: 50%; background: rgb(37, 211, 102); display: grid; place-items: center; box-shadow: rgba(37, 211, 102, 0.7) 0px 12px 30px -8px; transition: transform 0.3s; }

.wa-float:hover { transform: scale(1.08); }

.wa-float svg { width: 32px; height: 32px; color: rgb(255, 255, 255); }

.wa-float::before { content: "Chat on WhatsApp"; position: absolute; right: 72px; top: 50%; transform: translateY(-50%) translateX(6px); background: var(--ink); color: rgb(255, 255, 255); font-size: 0.8rem; font-weight: 600; padding: 8px 14px; border-radius: 8px; white-space: nowrap; opacity: 0; pointer-events: none; transition: opacity 0.25s, transform 0.25s; }

.wa-float:hover::before { opacity: 1; transform: translateY(-50%) translateX(0px); }

.wa-pulse { position: absolute; inset: 0px; border-radius: 50%; background: rgb(37, 211, 102); animation: 2.2s ease-out 0s infinite normal none running wapulse; z-index: -1; }

@keyframes wapulse { 
  0% { transform: scale(1); opacity: 0.5; }
  100% { transform: scale(1.7); opacity: 0; }
}

.to-top { position: fixed; left: 20px; bottom: 20px; z-index: 88; width: 48px; height: 48px; border-radius: 50%; background: var(--ink); color: rgb(255, 255, 255); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; display: grid; place-items: center; opacity: 0; visibility: hidden; transform: translateY(10px); transition: opacity 0.3s, transform 0.3s, visibility 0.3s, background 0.2s; }

.to-top.show { opacity: 1; visibility: visible; transform: translateY(0px); }

