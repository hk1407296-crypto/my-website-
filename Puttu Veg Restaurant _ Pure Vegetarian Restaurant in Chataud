.lb-btn { position: absolute; background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.25); color: rgb(255, 255, 255); width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; cursor: pointer; transition: background 0.2s, transform 0.2s; }

