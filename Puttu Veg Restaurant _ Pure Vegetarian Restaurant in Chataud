.rev-cta { text-align: center; margin-top: 44px; }

.quote-mark { font-family: Fraunces; font-size: 3rem; line-height: 0.6; color: var(--clay); opacity: 0.35; }

.loc-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(24px, 4vw, 54px); align-items: stretch; }

