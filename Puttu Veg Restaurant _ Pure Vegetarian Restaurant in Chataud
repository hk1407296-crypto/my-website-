.map-card { border-radius: var(--radius); overflow: hidden; position: relative; box-shadow: var(--shadow); min-height: 380px; display: flex; flex-direction: column; justify-content: flex-end; color: rgb(255, 255, 255); }

.map-card img { position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover; }

