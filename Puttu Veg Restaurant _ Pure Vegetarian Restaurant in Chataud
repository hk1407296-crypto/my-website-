.final p { color: rgba(255, 255, 255, 0.88); max-width: 48ch; margin: 18px auto 34px; font-size: 1.1rem; }

.final .fa { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

footer { background: var(--forest); color: rgba(247, 241, 230, 0.75); padding: 70px 0px 30px; }

.foot-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 40px; }

