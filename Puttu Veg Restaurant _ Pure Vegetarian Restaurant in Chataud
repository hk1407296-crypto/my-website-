footer ul li a, footer p a { transition: color 0.2s; }

footer ul li a:hover, footer p a:hover { color: var(--gold); }

footer .tagline { margin: 16px 0px 20px; max-width: 32ch; font-size: 0.92rem; }

.foot-social { display: inline-flex; align-items: center; gap: 10px; color: rgb(255, 255, 255); font-weight: 600; padding: 10px 16px; border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 999px; transition: background 0.2s, border-color 0.2s; }

