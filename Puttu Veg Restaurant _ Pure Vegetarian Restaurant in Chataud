.reveal.d2 { transition-delay: 0.16s; }

.reveal.d3 { transition-delay: 0.24s; }

.reveal.d4 { transition-delay: 0.32s; }

a:focus-visible, button:focus-visible, .filter:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; border-radius: 6px; }

@media (max-width: 1024px) {
