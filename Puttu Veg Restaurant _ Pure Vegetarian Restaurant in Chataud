.gal-filters { display: flex; gap: 10px; flex-wrap: wrap; margin: 30px 0px 32px; }

.masonry { columns: 3; column-gap: 18px; }

.masonry .g-item { break-inside: avoid; margin-bottom: 18px; border-radius: 14px; overflow: hidden; cursor: pointer; position: relative; transition: opacity 0.4s, transform 0.4s; display: block; width: 100%; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 0px; background: none; }

.masonry .g-item img { width: 100%; transition: transform 0.6s; }

